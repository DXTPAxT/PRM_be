# Environment variables – copy sang .env và điền giá trị thật
# KHÔNG commit file .env vào git

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local Docker: cả 2 trùng nhau
# Staging Supabase/Neon: url = pooled (pgbouncer), directUrl = direct connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothing_store
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clothing_store?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clothing_store?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# ── Email OTP (Gmail SMTP) ───────────────────────────────────────────────────
# Tạo App Password tại https://myaccount.google.com/apppasswords
# Chỉ điền giá trị thật trong .env, không commit thông tin đăng nhập.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="PRM Shop <your-email@gmail.com>"

# ── Shipping GHN (Giao Hàng Nhanh) ───────────────────────────────────────────
# Đăng ký tài khoản + lấy Token, ShopID tại https://khachhang.ghn.vn (hoặc trang dev).
# Docs: https://api.ghn.vn/home/docs  |  Chỉ điền giá trị thật trong .env, không commit.
# GHN_API_URL: dev (test, không tạo đơn thật) = https://dev-online-gateway.ghn.vn
#              production                       = https://online-gateway.ghn.vn
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=your-ghn-api-token
GHN_SHOP_ID=your-ghn-shop-id
# ShopID quận/huyện kho lấy hàng (from_district_id) — lấy từ API GHN get-district.
GHN_FROM_DISTRICT_ID=

# ── Payment VNPay ────────────────────────────────────────────────────────────
# Đăng ký sandbox tại https://sandbox.vnpayment.vn → lấy TmnCode + HashSecret.
# Docs: https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html
# Chỉ điền giá trị thật trong .env, không commit. HashSecret dùng để ký/verify checksum.
# VNPAY_URL: sandbox = https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#            production = https://vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL FE để VNPay redirect user về sau khi thanh toán (trang hiển thị kết quả).
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
